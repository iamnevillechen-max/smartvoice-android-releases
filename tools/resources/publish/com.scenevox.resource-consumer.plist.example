<!-- Template only: not installed. Generated by deploy_resource_runtime.py; RUNTIME is the reviewed Application Support worker. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.scenevox.resource-consumer</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string><string>RUNTIME/tools/resources/consume_sound_resource_artifact.py</string>
  </array>
  <key>WorkingDirectory</key><string>RUNTIME</string>
